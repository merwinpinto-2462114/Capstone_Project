# ============================================================
# EXAMFLOW – Environment Variables
# Copy to .env and fill in values before running.
# Production secrets MUST be loaded from Google Cloud Secret Manager.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=EXAMFLOW
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
USE_CLOUD_LOGGING=false

# ---- Database ----
# Local development (docker-compose):
DATABASE_URL=postgresql+asyncpg://examflow:examflow_dev_password@localhost:5432/examflow_db
# Cloud SQL (production) – inject via Secret Manager:
# DATABASE_URL=postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---- Pagination ----
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# ---- Evaluation Engine Rules ----
MIN_ATTEMPT_PERCENTAGE=10.0
NORMALISATION_MIN_SHIFT_SIZE=100

# ---- Google Cloud (production) ----
GCP_PROJECT_ID=your-gcp-project-id
CLOUD_SQL_INSTANCE=your-project:region:instance-name
